{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xyfer-lol",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      "binding": "MODS"
    }
  ],
  "secrets": {
    "required": ["ADMIN_KEY"]
  },
  "routes": [
    {
      "pattern": "xyfer.lol/*",
      "zone_name": "xyfer.lol"
    },
    {
      "pattern": "www.xyfer.lol/*",
      "zone_name": "xyfer.lol"
    }
  ],
  "workers_dev": true
}
